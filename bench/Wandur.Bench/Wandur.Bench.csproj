<Project Sdk="Microsoft.NET.Sdk">
  <!-- The performance harness (docs/perf.md). Not part of Wandur.sln and never packaged: it references the client
       to measure it, serves a loopback MUD and a fake directory, and launches the built app with its probe on. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <TieredPGO>true</TieredPGO>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Wandur.Desktop/Wandur.Desktop.csproj" />
    <PackageReference Include="Avalonia.Headless" Version="12.1.2" />
  </ItemGroup>
</Project>
