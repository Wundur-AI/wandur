[Desktop Entry]
# Template, not the installed entry. install-desktop-entry.sh copies it to
# ~/.local/share/applications/net.wandur.client.desktop and rewrites the Exec line with the
# absolute, quoted path of the Wandur in this folder, because a .desktop file cannot refer
# to a path relative to itself.
Type=Application
Name=Wandur Mud Client
GenericName=MUD Client
Comment=Play text MUDs and MUSHes
Exec=Wandur
Icon=net.wandur.client
Terminal=false
Categories=Game;Network;
StartupWMClass=Wandur
