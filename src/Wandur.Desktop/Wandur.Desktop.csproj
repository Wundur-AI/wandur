<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>Wandur</AssemblyName>
    <!-- What Windows shows in the file's details and Task Manager. The executable stays Wandur.exe. -->
    <Product>Wandur Mud Client</Product>
    <AssemblyTitle>Wandur Mud Client</AssemblyTitle>
    <Description>Wandur Mud Client (WMC)</Description>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <ApplicationIcon>Assets/Wandur.ico</ApplicationIcon>
    <!-- Precompiled code in every publish that names a runtime (the release packages), so the first start does not
         wait for the JIT: 1,016 to 704 ms to a usable window on an M3 Pro (docs/perf.md). Builds, tests and
         dotnet run are unaffected. -->
    <PublishReadyToRun Condition="'$(RuntimeIdentifier)' != ''">true</PublishReadyToRun>
  </PropertyGroup>
  <ItemGroup>
    <AvaloniaResource Include="Assets/icon-256.png" />
    <AvaloniaResource Include="Assets/Skins/armored-wear.png" />
    <AvaloniaResource Include="Styles/ThemeDockSkin.axaml" />
    <AvaloniaResource Include="Styles/Fleet.axaml" />
    <AvaloniaResource Include="Styles/ArmoredDocks.axaml" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Wandur.Core/Wandur.Core.csproj" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.12" />
    <PackageReference Include="Iciclecreek.Avalonia.Terminal" Version="4.0.2" />
    <PackageReference Include="Avalonia.AvaloniaEdit" Version="12.0.0" />
    <PackageReference Include="Avalonia.Controls.ColorPicker" Version="12.1.2" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.2" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.2" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.2" />
    <PackageReference Include="Dock.Avalonia" Version="12.1.0.6" />
    <PackageReference Include="Dock.Model.Mvvm" Version="12.1.0.6" />
    <PackageReference Include="Dock.Avalonia.Themes.Fluent" Version="12.1.0.6" />
  </ItemGroup>
</Project>
